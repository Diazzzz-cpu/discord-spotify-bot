{
  "name": "discord-spotify-bot",
  "version": "1.0.0",
  "description": "A high-performance Discord music bot with Spotify integration using TypeScript and Lavalink",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node dist/index.js",
    "dev": "tsx src/index.ts",
    "lavalink": "java -jar lavalink/Lavalink.jar"
  },
  "keywords": [
    "discord",
