  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "kazagumo": "^3.4.3",
    "shoukaku": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
